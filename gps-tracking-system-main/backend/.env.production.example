# ════════════════════════════════════════════════════════════════════════════════
#   NTPC-MUNPL GPS TRACKING SYSTEM — PRODUCTION ENVIRONMENT CONFIG
#   Copy this file to .env and fill in all values before starting the server.
# ════════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Node.js server listens on internally
PORT=3000

# NODE_ENV must be "production" on the live server
NODE_ENV=production

# ─── Public URL ───────────────────────────────────────────────────────────────
# The permanent IP address or hostname of this NTPC server, as seen from the
# devices (trackers) that will connect to it.
# Format: http://<IP-or-HOSTNAME>:<PORT>   — NO trailing slash
# Example: http://10.1.2.100:3000
#
SERVER_PUBLIC_URL=http://<NTPC_SERVER_IP>:3000

# ─── Dashboard Authentication ───────────────────────────────────────────
# Protects the fleet dashboard and all data APIs with HTTP Basic Auth.
# The tracker page (/tracker.html) and Socket.IO remain ALWAYS PUBLIC.
# If left blank, the dashboard will be open (not recommended for public exposure).
#
DASHBOARD_USER=<CHOOSE_A_USERNAME>
DASHBOARD_PASSWORD=<CHOOSE_A_STRONG_PASSWORD>

# ─── Google Maps API Key ──────────────────────────────────────────────────────
# Required for the map to display in the dashboard.
# Obtain from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Geocoding API
#
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# ─── History Retention ────────────────────────────────────────────────────────
# How many days of GPS history to keep. Records older than this are auto-deleted
# once every 24 hours. Default: 90 days.
#
HISTORY_RETENTION_DAYS=90

# ─── MS SQL Server (Primary Database) ────────────────────────────────────────
# Connect to the existing NTPC SQL Server instance.
# If any of these are blank, the system will fall back to local SQLite.
#
MSSQL_SERVER=<SQL_SERVER_HOSTNAME_OR_IP>
MSSQL_PORT=1433
MSSQL_DATABASE=gps_tracking
MSSQL_USER=<SQL_USERNAME>
MSSQL_PASSWORD=<SQL_PASSWORD>

# Set to true if SQL Server requires encrypted connections (recommended on LAN)
MSSQL_ENCRYPT=false

# Set to true if using a self-signed certificate on SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=true
