# Port configuration
PORT=3000

# ─── Google Maps API Key ───────────────────────────────────────────────────────
# Leave blank to be prompted via the Dashboard UI on first load.
GOOGLE_MAPS_API_KEY=

# ─── NTPC Server Public URL ───────────────────────────────────────────────────
# This is the permanent public IP/domain of the NTPC server.
# The tracker QR code is generated from this URL and NEVER changes.
# Format: http://<IP>:<PORT>  (no trailing slash)
# SERVER_PUBLIC_URL=http://<YOUR_PUBLIC_IP_OR_DOMAIN>:<PORT>

# ─── History Database ─────────────────────────────────────────────────────────
# How many days of location history to keep (older records auto-deleted daily)
HISTORY_RETENTION_DAYS=90
